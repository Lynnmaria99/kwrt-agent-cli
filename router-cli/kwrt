# ---------------------------------------------------------------- 入口 ----

# 前置开关
while [ $# -gt 0 ]; do
  case "$1" in
    -t | --text) TEXT=1; shift ;;
    -y | --yes) YES=1; shift ;;
    -h | --help) cmd_help; exit 0 ;;
    -v | --version) printf 'kwrt %s\n' "$KWRT_VERSION"; exit 0 ;;
    --) shift; break ;;
    -*) die "未知选项: $1（kwrt help 查看用法）" ;;
    *) break ;;
  esac
done

CMD="$1"
[ $# -gt 0 ] && shift

case "$CMD" in
  info | sysinfo) cmd_info ;;
  status | st) cmd_status ;;
  net | iface | interfaces) cmd_net ;;
  route | routes) cmd_route ;;
  clients | stations | hosts) cmd_clients ;;
  dhcp | leases) cmd_dhcp ;;
  wifi | wireless)
    case "$1" in
      reload) cmd_wifi_reload "$@" ;;
      *) cmd_wifi ;;
    esac
    ;;
  services | svc-list) cmd_services ;;
  svc | service) cmd_svc "$@" ;;
  logs | log | logread) cmd_logs "$@" ;;
  firewall | fw) cmd_firewall ;;
  dns | resolve) cmd_dns "$@" ;;
  ping) cmd_ping "$@" ;;
  doctor | check | selfcheck) cmd_doctor ;;
  uci) cmd_uci "$@" ;;
  pkg | opkg) cmd_pkg "$@" ;;
  ubus) cmd_ubus "$@" ;;
  reboot) cmd_reboot "$@" ;;
  help | -h | --help | "") cmd_help ;;
  *) die "未知命令: $CMD（kwrt help 查看用法）" ;;
esac
